//@version=6
indicator("天底ひも理論 (String Theory)", shorttitle="StringTheory", overlay=true,
          max_lines_count=200, max_labels_count=200)

// ═══════════════════════════════════════════════════════════════════
//  天底ひも理論  v6.0
//
//  ① 戦い (レンジ) : BBW/ATR が圧縮 → レンジを検出 (黄色背景)
//  ② 想定値計算    : レンジ幅 × 倍率 (戦いが長いほど広がる)
//  ③ びよーん      : ブレイクアウト → 天/底ひもを描画
//  ④ 純度 (purity) : 方向性の純粋さ = 純移動量 ÷ 総移動量 × 100%
//                    例: 2pip陽線×4本の後に陰線8pip → 純度=0% (打ち消し)
//  ⑤ シグナル      : 純度が目標閾値以上 → SHORT / LONG
//  ⑥ 観測終了      : 純度が落下 or ブレイクレベル割れ
// ═══════════════════════════════════════════════════════════════════

// ──────────────────────────────────────────────────────────────────
// 入力設定
// ──────────────────────────────────────────────────────────────────

grp_bb = "ボリンジャーバンド"
bb_len  = input.int   (20,    "BB 期間",  minval=1,  group=grp_bb)
bb_mult = input.float (2.0,   "BB 乗数",  step=0.1,  group=grp_bb)
bb_src  = input.source(close, "ソース",              group=grp_bb)
bb_show = input.bool  (true,  "BB 表示",             group=grp_bb)

grp_rng = "レンジ(戦い)検出設定"
bbw_thr   = input.float(2.0,  "BBW/ATR 閾値 (この値以下=レンジ)",        minval=0.5, maxval=6.0, step=0.1, group=grp_rng,
            tooltip="BBW÷ATR がこの値以下でレンジ判定。大きいほど検出しやすい。")
rng_min   = input.int  (5,    "最小レンジ継続バー数",                     minval=3, maxval=50, group=grp_rng)
base_mult = input.float(1.0,  "目標倍率 (基本)",                          minval=0.3, maxval=3.0, step=0.1, group=grp_rng)
dur_bonus = input.float(0.005,"継続加算係数 (バー数 × この値)",            minval=0.0, maxval=0.05, step=0.001, group=grp_rng,
            tooltip="戦いが長いほど倍率に加算される。レンジ20バー×0.005=+0.1倍。")

grp_pur = "純度設定"
sig_purity  = input.float(70.0, "シグナル発火純度 (%)",   minval=40.0, maxval=100.0, step=5.0, group=grp_pur,
              tooltip="純度がこの値以上になったとき逆張りシグナルを発火。低いほどシグナルが出やすい。")
cancel_purity = input.float(20.0, "観測終了 純度 (%)",   minval=0.0, maxval=60.0, step=5.0, group=grp_pur,
              tooltip="純度がこの値を下回ったら観測終了。")
cooldown    = input.int  (15,   "クールダウン (バー数)",  minval=5, maxval=100, group=grp_pur)

grp_cl = "カラー設定"
col_rng  = input.color(color.new(color.yellow, 82), "レンジゾーン背景色", group=grp_cl)
col_tgt  = input.color(color.yellow,                "想定値ライン色",     group=grp_cl)
col_hi   = input.color(color.red,                   "天のひも色",         group=grp_cl)
col_lo   = input.color(color.lime,                  "底のひも色",         group=grp_cl)
col_long = input.color(color.lime,                  "LONG シグナル色",    group=grp_cl)
col_sht  = input.color(color.red,                   "SHORT シグナル色",   group=grp_cl)

// ──────────────────────────────────────────────────────────────────
// ボリンジャーバンド計算
// ──────────────────────────────────────────────────────────────────

float bb_basis = ta.sma(bb_src, bb_len)
float bb_dev   = ta.stdev(bb_src, bb_len)
float bb_upper = bb_basis + bb_mult * bb_dev
float bb_lower = bb_basis - bb_mult * bb_dev
float bb_bw    = bb_upper - bb_lower
float bb_pct   = bb_bw > 0.0 ? (close - bb_lower) / bb_bw : 0.5
float atr14    = ta.atr(14)
float bbw_ratio = atr14 > 0.0 ? bb_bw / atr14 : 9.9

p_mid = plot(bb_show ? bb_basis : na, "BB 中心", color=color.new(color.white, 55), linewidth=1)
p_top = plot(bb_show ? bb_upper : na, "BB 上限", color=color.new(color.gray,  45), linewidth=1)
p_bot = plot(bb_show ? bb_lower : na, "BB 下限", color=color.new(color.gray,  45), linewidth=1)
fill(p_top, p_bot, color=color.new(color.gray, 90), title="BB 帯域")

// ──────────────────────────────────────────────────────────────────
// レンジ(戦い)検出
// ──────────────────────────────────────────────────────────────────

bool isRange = bbw_ratio < bbw_thr

var float rngHi    = na
var float rngLo    = na
var int   rngStart = 0
var int   rngBars  = 0
var bool  prevRng  = false

if isRange
    if not prevRng
        rngStart := bar_index
        rngHi    := high
        rngLo    := low
        rngBars  := 1
    else
        rngHi   := math.max(rngHi, high)
        rngLo   := math.min(rngLo, low)
        rngBars += 1

bgcolor(isRange ? col_rng : na, title="レンジゾーン背景")

// ★ バグ修正: wasRange を prevRng 更新「前」に保存
bool wasRange = prevRng
prevRng := isRange

// ──────────────────────────────────────────────────────────────────
// ブレイクアウト検出 & 天底想定値計算
// ──────────────────────────────────────────────────────────────────

// wasRange = 「前バーまでレンジだった」, isRange = 「今バーはレンジ外」
bool breakUp = (wasRange and not isRange and close > rngHi and rngBars >= rng_min)
bool breakDn = (wasRange and not isRange and close < rngLo and rngBars >= rng_min)

var float tgtHi    = na
var float tgtLo    = na
var float brkLevel = na
var int   brkDir   = 0     // +1=上抜け, -1=下抜け, 0=追跡なし
var int   lastSig  = -999

// 純度計算用: ブレイク後の累積絶対移動量 と 純移動量
var float cumAbsMove = 0.0  // ブレイク後の |close - close[1]| の累積
var float netMove    = 0.0  // ブレイク後の目標方向への純移動量

var line   hiStr    = na
var line   loStr    = na
var line   hiTgtLn  = na
var line   loTgtLn  = na
var label  hiTgtLbl = na
var label  loTgtLbl = na

if breakUp or breakDn
    float rngWidth = rngHi - rngLo
    float mult     = base_mult + float(rngBars) * dur_bonus
    cumAbsMove    := 0.0
    netMove       := 0.0

    if breakUp
        tgtHi    := rngHi + rngWidth * mult
        brkLevel := rngHi
        brkDir   := 1

        if not na(hiStr)
            line.delete(hiStr)
        hiStr := line.new(rngStart, rngLo, bar_index + 80, tgtHi,
                         color=col_hi, width=2, style=line.style_solid)

        if not na(hiTgtLn)
            line.delete(hiTgtLn)
        hiTgtLn := line.new(bar_index - rngBars, tgtHi, bar_index + 100, tgtHi,
                            color=col_tgt, width=2, style=line.style_dashed)
        if not na(hiTgtLbl)
            label.delete(hiTgtLbl)
        hiTgtLbl := label.new(bar_index + 3, tgtHi,
                              "天の想定値 " + str.tostring(tgtHi, "#.###"),
                              color=color.new(col_sht, 15), textcolor=color.white,
                              style=label.style_label_left, size=size.small)

    if breakDn
        tgtLo    := rngLo - rngWidth * mult
        brkLevel := rngLo
        brkDir   := -1

        if not na(loStr)
            line.delete(loStr)
        loStr := line.new(rngStart, rngHi, bar_index + 80, tgtLo,
                         color=col_lo, width=2, style=line.style_solid)

        if not na(loTgtLn)
            line.delete(loTgtLn)
        loTgtLn := line.new(bar_index - rngBars, tgtLo, bar_index + 100, tgtLo,
                            color=col_tgt, width=2, style=line.style_dashed)
        if not na(loTgtLbl)
            label.delete(loTgtLbl)
        loTgtLbl := label.new(bar_index + 3, tgtLo,
                              "底の想定値 " + str.tostring(tgtLo, "#.###"),
                              color=color.new(col_long, 15), textcolor=color.black,
                              style=label.style_label_left, size=size.small)

// ──────────────────────────────────────────────────────────────────
// 純度計算 (Directional Efficiency)
//
//   純度 = 目標方向への純移動量 ÷ 総絶対移動量 × 100
//
//   例) 2pip陽線×4本, 8pip陰線×1本 (上方ブレイク中)
//     累積絶対移動 = 2+2+2+2+8 = 16pip
//     純移動量     = +8-8 = 0pip (ブレイクレベルまで戻った)
//     純度 = 0÷16×100 = 0% → 観測終了
// ──────────────────────────────────────────────────────────────────

float purity = na
bool  longOk = false
bool  shortOk = false

if brkDir != 0 and not na(brkLevel)
    // ブレイク後の各バーの絶対移動を累積
    float barMove = math.abs(close - close[1])
    cumAbsMove += barMove

    if brkDir == 1
        // 上方ブレイク中: ブレイクレベルからの純移動 (上方向がプラス)
        netMove := close - brkLevel
        purity  := cumAbsMove > 0.0 ? math.max(netMove / cumAbsMove * 100.0, 0.0) : 0.0

        // シグナル: 純度が閾値以上
        if purity >= sig_purity and (bar_index - lastSig) > cooldown
            shortOk     := true
            lastSig     := bar_index

        // 観測終了: 純度が低下 or ブレイクレベル割れ
        if purity < cancel_purity or close < brkLevel
            brkDir      := 0
            cumAbsMove  := 0.0
            netMove     := 0.0

    else if brkDir == -1
        // 下方ブレイク中: ブレイクレベルからの純移動 (下方向がプラス)
        netMove := brkLevel - close
        purity  := cumAbsMove > 0.0 ? math.max(netMove / cumAbsMove * 100.0, 0.0) : 0.0

        if purity >= sig_purity and (bar_index - lastSig) > cooldown
            longOk      := true
            lastSig     := bar_index

        if purity < cancel_purity or close > brkLevel
            brkDir      := 0
            cumAbsMove  := 0.0
            netMove     := 0.0

// ──────────────────────────────────────────────────────────────────
// シグナル表示
// ──────────────────────────────────────────────────────────────────

plotshape(longOk,  "LONG ▲",  shape.labelup,   location.belowbar,
          color=col_long, textcolor=color.black, text="LONG",  size=size.normal)
plotshape(shortOk, "SHORT ▼", shape.labeldown, location.abovebar,
          color=col_sht,  textcolor=color.white, text="SHORT", size=size.normal)

// ──────────────────────────────────────────────────────────────────
// 情報テーブル (右上)
// ──────────────────────────────────────────────────────────────────

var table tbl = table.new(position.top_right, 2, 7,
                          bgcolor=color.new(color.black, 65),
                          border_color=color.new(color.gray, 50), border_width=1,
                          frame_color=color.new(color.aqua, 50), frame_width=1)

if barstate.islast
    table.cell(tbl, 0, 0, "天底ひも理論",  text_color=color.aqua, text_size=size.small,
               bgcolor=color.new(color.navy, 40), text_halign=text.align_center)
    table.cell(tbl, 1, 0, "String Theory", text_color=color.aqua, text_size=size.small,
               bgcolor=color.new(color.navy, 40), text_halign=text.align_center)

    string phaseStr = (isRange ? "⚔  戦い中 (" + str.tostring(rngBars) + "バー)" : brkDir == 1 ? "↑ 上昇追跡中" : brkDir == -1 ? "↓ 下降追跡中" : "– 待機中")
    color  phaseCol = (isRange ? color.yellow : brkDir != 0 ? color.aqua : color.gray)
    table.cell(tbl, 0, 1, "フェーズ",  text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 1, phaseStr,    text_color=phaseCol,    text_size=size.tiny)

    string hiStr2 = (not na(tgtHi) and brkDir == 1 ? str.tostring(tgtHi, "#.###") : "–")
    table.cell(tbl, 0, 2, "天の想定値", text_color=col_sht, text_size=size.tiny)
    table.cell(tbl, 1, 2, hiStr2,       text_color=col_sht, text_size=size.tiny)

    string loStr2 = (not na(tgtLo) and brkDir == -1 ? str.tostring(tgtLo, "#.###") : "–")
    table.cell(tbl, 0, 3, "底の想定値", text_color=col_long, text_size=size.tiny)
    table.cell(tbl, 1, 3, loStr2,       text_color=col_long, text_size=size.tiny)

    color purCol = (not na(purity) and purity >= sig_purity ? col_sht : not na(purity) and purity >= sig_purity * 0.6 ? color.orange : color.gray)
    string purStr = not na(purity) ? str.tostring(math.round(purity, 1)) + "%" : "–"
    table.cell(tbl, 0, 4, "純度 (purity)", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 4, purStr,          text_color=purCol,       text_size=size.tiny)

    string cumStr = not na(purity) ? str.tostring(math.round(cumAbsMove / (syminfo.mintick * 10), 1)) + " pips" : "–"
    table.cell(tbl, 0, 5, "累積移動量",  text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 5, cumStr,         text_color=color.gray,  text_size=size.tiny)

    string sigStr = (shortOk ? "▼ SHORT (天到達)" : longOk ? "▲ LONG  (底到達)" : "–  待機中")
    color  sigCol = (shortOk ? col_sht : longOk ? col_long : color.gray)
    table.cell(tbl, 0, 6, "シグナル", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 6, sigStr,     text_color=sigCol,      text_size=size.tiny)
