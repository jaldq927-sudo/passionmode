//@version=6
indicator("天底ひも理論 (String Theory)", shorttitle="StringTheory", overlay=true,
          max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════
//  天底ひも理論 (Tenbottom String Theory)  v3.0
//  わっきゃい氏考案
//
//  【天底ひも理論の核心】
//   「天のひも」= 直近2つの山(スイングハイ)を結ぶライン → 上値抵抗として右延長
//   「底のひも」= 直近2つの谷(スイングロー)を結ぶライン → 下値支持として右延長
//
//  【シグナル条件 (厳格化)】
//   ★ LONG (▲) : 下記をすべて同時に満たすときのみ
//      1. スイングロー確定 (ta.pivotlow)
//      2. そのスイングローが「底のひも」投影値 ± 許容pips 以内
//      3. BB %B ≦ 0.10 (極端な売られ過ぎ)
//      4. 前回LONGシグナルから N バー以上経過 (クールダウン)
//
//   ★ SHORT (▼) : 下記をすべて同時に満たすときのみ
//      1. スイングハイ確定 (ta.pivothigh)
//      2. そのスイングハイが「天のひも」投影値 ± 許容pips 以内
//      3. BB %B ≧ 0.90 (極端な買われ過ぎ)
//      4. 前回SHORTシグナルから N バー以上経過 (クールダウン)
//
//   ◎ TRL : ひもへの接触 (LONG/SHORT以外の軽い注意マーク)
//      価格がひも延長線を実際にクロスした最初のバー のみ表示
//
//  【背景色は非表示】チャートの視認性を確保
// ═══════════════════════════════════════════════════════════════════

// ──────────────────────────────────────────────────────────────────
// 入力設定
// ──────────────────────────────────────────────────────────────────

grp_sw = "スイング検出設定"
swing_len   = input.int(8,  "スイング検出期間 (左右バー数)", minval=3, maxval=30, group=grp_sw,
              tooltip="大きいほど大きな転換点のみ検出。デフォルト8。")
num_str     = input.int(4,  "保持するひも本数 (上下それぞれ)", minval=2, maxval=10, group=grp_sw)
ext_bars    = input.int(60, "ひも右延長バー数",               minval=10, maxval=300, group=grp_sw)

grp_bb = "ボリンジャーバンド"
bb_len  = input.int   (20,    "BB 期間",  minval=1, group=grp_bb)
bb_mult = input.float (2.0,   "BB 乗数",  step=0.1, group=grp_bb)
bb_src  = input.source(close, "ソース",             group=grp_bb)
bb_show = input.bool  (true,  "BB 表示",            group=grp_bb)

grp_sig = "シグナル設定 (厳格モード)"
touch_pips   = input.int  (6,    "ひもタッチ許容 pips",          minval=1, maxval=30, group=grp_sig,
               tooltip="スイング高値/安値がひも投影値から何pips以内に入ったときシグナルを出すか。")
long_thr     = input.float(0.10, "LONG BB%B 閾値 (この値以下)",  minval=0.0, maxval=0.30, step=0.01, group=grp_sig,
               tooltip="BB %B がこの値以下 = 極端な売られ過ぎ域のみ LONG シグナル。デフォルト0.10。")
short_thr    = input.float(0.90, "SHORT BB%B 閾値 (この値以上)", minval=0.70, maxval=1.0, step=0.01, group=grp_sig,
               tooltip="BB %B がこの値以上 = 極端な買われ過ぎ域のみ SHORT シグナル。デフォルト0.90。")
cooldown     = input.int  (15,   "シグナルクールダウン (バー数)", minval=5, maxval=100, group=grp_sig,
               tooltip="前回シグナルから何バー経過しないと次のシグナルを出さないか。")
show_trl     = input.bool (true, "TRL マーク表示 (ひもクロス検知)", group=grp_sig)

grp_lv = "重要水平レベル (黄色ライン)"
show_key  = input.bool  (true,  "表示",         group=grp_lv)
key_mode  = input.string("自動", "検出モード",   options=["自動", "手動"], group=grp_lv)
key_price = input.float (0.0,   "  └ 手動価格", group=grp_lv)
key_lb    = input.int   (300,   "  └ 自動検出ルックバック (バー数)", minval=50, maxval=2000, group=grp_lv)

grp_cl = "カラー設定"
col_hi    = input.color(color.aqua,               "天のひも色",     group=grp_cl)
col_lo    = input.color(color.aqua,               "底のひも色",     group=grp_cl)
col_cross = input.color(color.new(color.aqua, 65),"クロスライン色", group=grp_cl)
col_key   = input.color(color.yellow,             "重要レベル色",   group=grp_cl)
col_long  = input.color(color.lime,               "LONGシグナル色", group=grp_cl)
col_short = input.color(color.red,                "SHORTシグナル色",group=grp_cl)
col_ph    = input.color(color.new(color.red, 40), "山マーク色",     group=grp_cl)
col_pl    = input.color(color.blue,               "谷マーク色",     group=grp_cl)

// ──────────────────────────────────────────────────────────────────
// ボリンジャーバンド
// ──────────────────────────────────────────────────────────────────

float bb_basis = ta.sma(bb_src, bb_len)
float bb_dev   = ta.stdev(bb_src, bb_len)
float bb_upper = bb_basis + bb_mult * bb_dev
float bb_lower = bb_basis - bb_mult * bb_dev
float bb_bw    = bb_upper - bb_lower
float bb_pct   = bb_bw > 0.0 ? (close - bb_lower) / bb_bw : 0.5

p_mid = plot(bb_show ? bb_basis : na, "BB 中心", color=color.new(color.white, 55), linewidth=1)
p_top = plot(bb_show ? bb_upper : na, "BB 上限", color=color.new(color.gray,  45), linewidth=1)
p_bot = plot(bb_show ? bb_lower : na, "BB 下限", color=color.new(color.gray,  45), linewidth=1)
fill(p_top, p_bot, color=color.new(color.gray, 90), title="BB 帯域")

// ──────────────────────────────────────────────────────────────────
// スイングハイ・スイングロー検出
// ──────────────────────────────────────────────────────────────────

float ph = ta.pivothigh(high, swing_len, swing_len)
float pl = ta.pivotlow (low,  swing_len, swing_len)

// ──────────────────────────────────────────────────────────────────
// ひも管理
// ──────────────────────────────────────────────────────────────────

var float prevHiVal = na
var int   prevHiBar = na
var float prevLoVal = na
var int   prevLoBar = na

var line[] hiLines    = array.new_line()
var line[] loLines    = array.new_line()
var line[] xLines     = array.new_line()

float pip = syminfo.mintick * 10.0

// ライン上のbar_indexにおけるY値を計算
lineY(line l, int b) =>
    int   x1 = line.get_x1(l)
    float y1 = line.get_y1(l)
    int   x2 = line.get_x2(l)
    float y2 = line.get_y2(l)
    int   dx = x2 - x1
    float sl = dx != 0 ? (y2 - y1) / float(dx) : 0.0
    y1 + sl * float(b - x1)

// ──────────────────────────────────────────────────────────────────
// 天のひも: 山→山
// ──────────────────────────────────────────────────────────────────

if not na(ph)
    int   cb  = bar_index - swing_len
    float cv  = ph
    if not na(prevHiVal)
        int   dx = cb - prevHiBar
        float sl = dx != 0 ? (cv - prevHiVal) / float(dx) : 0.0
        int   eb = bar_index + ext_bars
        line l = line.new(prevHiBar, prevHiVal, eb, cv + sl * float(eb - cb),
                         color=col_hi, width=2, style=line.style_solid)
        array.push(hiLines, l)
        if array.size(hiLines) > num_str
            line.delete(array.shift(hiLines))
    prevHiVal := cv
    prevHiBar := cb

// ──────────────────────────────────────────────────────────────────
// 底のひも: 谷→谷 + クロスライン
// ──────────────────────────────────────────────────────────────────

if not na(pl)
    int   cb  = bar_index - swing_len
    float cv  = pl
    if not na(prevLoVal)
        int   dx = cb - prevLoBar
        float sl = dx != 0 ? (cv - prevLoVal) / float(dx) : 0.0
        int   eb = bar_index + ext_bars
        line l = line.new(prevLoBar, prevLoVal, eb, cv + sl * float(eb - cb),
                         color=col_lo, width=2, style=line.style_solid)
        array.push(loLines, l)
        if array.size(loLines) > num_str
            line.delete(array.shift(loLines))

        // クロスライン: 直近の山→現在の谷 (交差でTRLポイントを生成)
        if not na(prevHiVal) and not na(prevHiBar)
            int   xdx = cb - prevHiBar
            float xsl = xdx != 0 ? (cv - prevHiVal) / float(xdx) : 0.0
            int   xeb = bar_index + ext_bars
            line lx = line.new(prevHiBar, prevHiVal, xeb, cv + xsl * float(xeb - cb),
                              color=col_cross, width=1, style=line.style_dashed)
            array.push(xLines, lx)
            if array.size(xLines) > num_str
                line.delete(array.shift(xLines))

    prevLoVal := cv
    prevLoBar := cb

// ──────────────────────────────────────────────────────────────────
// 山・谷マーク (小さな丸)
// ──────────────────────────────────────────────────────────────────

plotshape(not na(ph), "山マーク", shape.circle, location.abovebar, color=col_ph, size=size.tiny)
plotshape(not na(pl), "谷マーク", shape.circle, location.belowbar, color=col_pl, size=size.small)

// ──────────────────────────────────────────────────────────────────
// 最新ひも投影値
// ──────────────────────────────────────────────────────────────────

float projHi = na
float projLo = na

if array.size(hiLines) > 0
    projHi := lineY(array.get(hiLines, array.size(hiLines) - 1), bar_index)

if array.size(loLines) > 0
    projLo := lineY(array.get(loLines, array.size(loLines) - 1), bar_index)

// ──────────────────────────────────────────────────────────────────
// クールダウン管理
// ──────────────────────────────────────────────────────────────────

var int lastLongBar  = -999
var int lastShortBar = -999

// ──────────────────────────────────────────────────────────────────
// LONG シグナル (厳格条件)
// スイングロー確定 + ひも付近 + 極度の売られ過ぎ + クールダウン
// ──────────────────────────────────────────────────────────────────

float tol = float(touch_pips) * pip

bool longOk = (not na(pl) and
               not na(projLo) and
               math.abs(pl - projLo) <= tol and
               bb_pct <= long_thr and
               (bar_index - lastLongBar) > cooldown)

if longOk
    lastLongBar := bar_index

plotshape(longOk, "LONG ▲", shape.labelup, location.belowbar,
          color=col_long, textcolor=color.black, text="LONG", size=size.normal)

// ──────────────────────────────────────────────────────────────────
// SHORT シグナル (厳格条件)
// スイングハイ確定 + ひも付近 + 極度の買われ過ぎ + クールダウン
// ──────────────────────────────────────────────────────────────────

bool shortOk = (not na(ph) and
                not na(projHi) and
                math.abs(ph - projHi) <= tol and
                bb_pct >= short_thr and
                (bar_index - lastShortBar) > cooldown)

if shortOk
    lastShortBar := bar_index

plotshape(shortOk, "SHORT ▼", shape.labeldown, location.abovebar,
          color=col_short, textcolor=color.white, text="SHORT", size=size.normal)

// ──────────────────────────────────────────────────────────────────
// TRL: ひもをクロスした最初のバーのみ表示
// (価格がひもを跨いだ瞬間 = 「ひもタッチ」の注意マーク)
// ──────────────────────────────────────────────────────────────────

var bool prevAboveHi = bool(na)
var bool prevAboveLo = bool(na)

bool nowAboveHi = not na(projHi) and close > projHi
bool nowAboveLo = not na(projLo) and close > projLo

bool crossedHi = (not na(prevAboveHi) and nowAboveHi != prevAboveHi)
bool crossedLo = (not na(prevAboveLo) and nowAboveLo != prevAboveLo)

bool trlOk = (show_trl and (crossedHi or crossedLo) and not longOk and not shortOk)

prevAboveHi := nowAboveHi
prevAboveLo := nowAboveLo

plotshape(trlOk, "TRL", shape.triangleup, location.belowbar,
          color=color.new(col_hi, 20), textcolor=col_hi, text="TRL", size=size.tiny)

// ──────────────────────────────────────────────────────────────────
// 重要水平レベル (黄色ライン)
// ──────────────────────────────────────────────────────────────────

var float keyLvl  = na
var line  keyLine = na

if show_key
    if key_mode == "手動"
        float kv = key_price > 0.0 ? key_price : na
        if not na(kv)
            if not na(keyLine)
                line.delete(keyLine)
            keyLine := line.new(bar_index - key_lb, kv, bar_index + ext_bars, kv,
                               color=col_key, width=2, style=line.style_solid)
    else
        // 自動: 直近スイングローの中で最も高いもの = 上値支持として機能しうる水準
        if not na(pl) and (na(keyLvl) or pl > keyLvl)
            keyLvl := pl
        if not na(keyLvl)
            if not na(keyLine)
                line.delete(keyLine)
            keyLine := line.new(bar_index - key_lb, keyLvl, bar_index + ext_bars, keyLvl,
                               color=col_key, width=2, style=line.style_solid)

// ──────────────────────────────────────────────────────────────────
// 情報テーブル (右上)
// ──────────────────────────────────────────────────────────────────

var table tbl = table.new(position.top_right, 2, 6,
                          bgcolor=color.new(color.black, 65),
                          border_color=color.new(color.gray, 50), border_width=1,
                          frame_color=color.new(color.aqua, 50), frame_width=1)

if barstate.islast
    table.cell(tbl, 0, 0, "天底ひも理論",  text_color=color.aqua, text_size=size.small,
               bgcolor=color.new(color.navy, 40), text_halign=text.align_center)
    table.cell(tbl, 1, 0, "String Theory", text_color=color.aqua, text_size=size.small,
               bgcolor=color.new(color.navy, 40), text_halign=text.align_center)

    color pbCol = (bb_pct >= 1.0 ? color.red : bb_pct >= short_thr ? color.orange : bb_pct <= 0.0 ? color.lime : bb_pct <= long_thr ? color.green : color.gray)
    table.cell(tbl, 0, 1, "BB %B",                       text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 1, str.tostring(bb_pct, "#.###"), text_color=pbCol,       text_size=size.tiny)

    string hiStr = not na(projHi) ? str.tostring(projHi, "#.###") : "–"
    table.cell(tbl, 0, 2, "天のひも (SHORT圧)", text_color=col_short, text_size=size.tiny)
    table.cell(tbl, 1, 2, hiStr,                text_color=col_short, text_size=size.tiny)

    string loStr = not na(projLo) ? str.tostring(projLo, "#.###") : "–"
    table.cell(tbl, 0, 3, "底のひも (LONG圧)", text_color=col_long, text_size=size.tiny)
    table.cell(tbl, 1, 3, loStr,               text_color=col_long, text_size=size.tiny)

    string klStr = (not na(keyLvl) ? str.tostring(keyLvl, "#.###") : (key_mode == "手動" and key_price > 0.0) ? str.tostring(key_price, "#.###") : "–")
    table.cell(tbl, 0, 4, "重要レベル", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 4, klStr,        text_color=col_key,     text_size=size.tiny)

    string sigTxt = (shortOk ? "▼ SHORT エントリー候補" : longOk ? "▲ LONG  エントリー候補" : trlOk ? "△ TRL タッチ" : "–  待機中")
    color  sigCol = (shortOk ? col_short : longOk ? col_long : trlOk ? col_hi : color.gray)
    table.cell(tbl, 0, 5, "シグナル", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 5, sigTxt,     text_color=sigCol,      text_size=size.tiny)
