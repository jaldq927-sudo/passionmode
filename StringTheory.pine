//@version=6
indicator("天底ひも理論 (String Theory)", shorttitle="StringTheory", overlay=true,
          max_lines_count=300, max_labels_count=200)

// ═══════════════════════════════════════════════════════════════════
//  天底ひも理論  v9.0  (最終版)
//
//  【画像分析による正解】
//   水色実線 = スイングハイ同士・スイングロー同士を結ぶ「ひも」
//              チャンネル状に並び、右に延長して将来の天底を示す
//   黄色水平線 = Pivot Point (日次均衡ライン)
//   TRL      = 価格がひもの延長線を横断した瞬間
//   LONG/SHORT = ひもの投影値に到達 + 純度が高い = 逆張り
//
//  【純度 (purity) の正しい計算】
//   「2pip陽線×4本の後に8pip陰線が来たら純度が悪い」
//   → 純度 = 目標方向への純移動量 ÷ 全絶対移動量 × 100%
//
//   LONG 用純度: 直近スイングハイ以降の「下への純度」
//     = 下方向の純移動量 ÷ 累積絶対移動量 × 100
//     高純度 = きれいに下落してきた = 底に到達したら逆張りの好機
//
//   SHORT 用純度: 直近スイングロー以降の「上への純度」
//     = 上方向の純移動量 ÷ 累積絶対移動量 × 100
//     高純度 = きれいに上昇してきた = 天に到達したら逆張りの好機
// ═══════════════════════════════════════════════════════════════════

// ──────────────────────────────────────────────────────────────────
// 入力設定
// ──────────────────────────────────────────────────────────────────

grp_sw = "スイング・ひも設定"
swing_len = input.int(8,  "スイング検出期間 (左右バー数)",     minval=3, maxval=30, group=grp_sw,
            tooltip="大きいほど大きな転換点のみ検出。5分足はデフォルト8推奨。")
num_str   = input.int(3,  "保持するひも本数 (上下それぞれ)",   minval=1, maxval=8,  group=grp_sw)
ext_bars  = input.int(60, "ひも右延長バー数",                  minval=10, maxval=200, group=grp_sw)

grp_bb = "ボリンジャーバンド"
bb_len  = input.int   (20,    "BB 期間",  minval=1,  group=grp_bb)
bb_mult = input.float (2.0,   "BB 乗数",  step=0.1,  group=grp_bb)
bb_src  = input.source(close, "ソース",              group=grp_bb)
bb_show = input.bool  (true,  "BB 表示",             group=grp_bb)

grp_sig = "純度・シグナル設定"
sig_purity  = input.float(55.0, "シグナル発火 純度(%) 閾値",    minval=20.0, maxval=95.0, step=5.0, group=grp_sig,
              tooltip="純度がこの値以上 かつ ひも到達でシグナル。下げると出やすくなる。")
touch_pips  = input.int  (10,   "ひもタッチ許容誤差 (pips)",     minval=1, maxval=50, group=grp_sig)
cooldown    = input.int  (20,   "クールダウン (バー数)",         minval=5, maxval=100, group=grp_sig)
trl_cd      = input.int  (8,    "TRL クールダウン (バー数)",     minval=1, maxval=30,  group=grp_sig)
use_adx     = input.bool (true,  "ADXフィルター (トレンド除外)", group=grp_sig,
              tooltip="ONの場合、ADX ≥ 閾値のトレンド相場ではシグナルをスキップ（WEMOFの『説明できる動き』除外）")
adx_thr     = input.float(25.0,  "ADX 閾値",  minval=15.0, maxval=50.0, step=1.0, group=grp_sig)

grp_piv = "Pivot Point (均衡ライン)"
show_pivot   = input.bool  (true,   "日次 Pivot Point 表示 (黄色線)", group=grp_piv,
               tooltip="Traditional Pivotの日次PP = (前日高値+安値+終値)÷3 を黄色水平線で表示。")
show_sr      = input.bool  (false,  "S1/R1 も表示",                  group=grp_piv)

grp_cl = "カラー設定"
col_hi   = input.color(color.aqua,               "天のひも色",     group=grp_cl)
col_lo   = input.color(color.aqua,               "底のひも色",     group=grp_cl)
col_piv  = input.color(color.yellow,             "Pivot Line色",   group=grp_cl)
col_long = input.color(color.lime,               "LONG シグナル色",group=grp_cl)
col_sht  = input.color(color.red,                "SHORT シグナル色",group=grp_cl)
col_ph   = input.color(color.new(color.red, 40), "山マーク色",     group=grp_cl)
col_pl   = input.color(color.blue,               "谷マーク色",     group=grp_cl)
col_trl  = input.color(color.new(color.aqua, 30),"TRL マーク色",   group=grp_cl)

// ──────────────────────────────────────────────────────────────────
// ボリンジャーバンド
// ──────────────────────────────────────────────────────────────────

float bb_basis = ta.sma(bb_src, bb_len)
float bb_dev   = ta.stdev(bb_src, bb_len)
float bb_upper = bb_basis + bb_mult * bb_dev
float bb_lower = bb_basis - bb_mult * bb_dev
float bb_bw    = bb_upper - bb_lower
float bb_pct   = bb_bw > 0.0 ? (close - bb_lower) / bb_bw : 0.5

p_mid = plot(bb_show ? bb_basis : na, "BB 中心", color=color.new(color.white, 55), linewidth=1)
p_top = plot(bb_show ? bb_upper : na, "BB 上限", color=color.new(color.gray,  45), linewidth=1)
p_bot = plot(bb_show ? bb_lower : na, "BB 下限", color=color.new(color.gray,  45), linewidth=1)
fill(p_top, p_bot, color=color.new(color.gray, 90))

// ADX (トレンド強度 — WEMOFの「説明できる動き」フィルター)
[_diP, _diM, adxVal] = ta.dmi(14, 14)
bool adxOk = not use_adx or adxVal < adx_thr

// ──────────────────────────────────────────────────────────────────
// Pivot Point (日次均衡ライン = 黄色水平線)
// Traditional Pivot: PP = (前日High + Low + Close) / 3
// ──────────────────────────────────────────────────────────────────

float dHigh  = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_on)
float dLow   = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_on)
float dClose = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)

float pp = (dHigh + dLow + dClose) / 3.0
float r1 = 2.0 * pp - dLow
float s1 = 2.0 * pp - dHigh

plot(show_pivot ? pp : na, "Pivot PP",  color=col_piv,                    linewidth=2, style=plot.style_line)
plot(show_sr    ? r1 : na, "Pivot R1",  color=color.new(col_piv, 50),     linewidth=1, style=plot.style_linebr)
plot(show_sr    ? s1 : na, "Pivot S1",  color=color.new(col_piv, 50),     linewidth=1, style=plot.style_linebr)

// ──────────────────────────────────────────────────────────────────
// スイングハイ・スイングロー検出
// ──────────────────────────────────────────────────────────────────

float ph = ta.pivothigh(high, swing_len, swing_len)
float pl = ta.pivotlow (low,  swing_len, swing_len)

// ──────────────────────────────────────────────────────────────────
// ひも描画 (天のひも = 山→山, 底のひも = 谷→谷)
// ──────────────────────────────────────────────────────────────────

var float prevHiVal = na
var int   prevHiBar = na
var float prevLoVal = na
var int   prevLoBar = na

var line[] hiLines = array.new_line()
var line[] loLines = array.new_line()

float pip = syminfo.mintick * 10.0

// ラインの指定barにおけるY値を返す
lineY(line l, int b) =>
    int   x1 = line.get_x1(l)
    float y1 = line.get_y1(l)
    int   x2 = line.get_x2(l)
    float y2 = line.get_y2(l)
    int   dx = x2 - x1
    float sl = dx != 0 ? (y2 - y1) / float(dx) : 0.0
    y1 + sl * float(b - x1)

// 天のひも
if not na(ph)
    int   cb = bar_index - swing_len
    float cv = ph
    if not na(prevHiVal)
        int   dx = cb - prevHiBar
        float sl = dx != 0 ? (cv - prevHiVal) / float(dx) : 0.0
        int   eb = bar_index + ext_bars
        line l = line.new(prevHiBar, prevHiVal, eb, cv + sl * float(eb - cb),
                         color=col_hi, width=2, style=line.style_solid)
        array.push(hiLines, l)
        if array.size(hiLines) > num_str
            line.delete(array.shift(hiLines))
    prevHiVal := cv
    prevHiBar := cb

// 底のひも
if not na(pl)
    int   cb = bar_index - swing_len
    float cv = pl
    if not na(prevLoVal)
        int   dx = cb - prevLoBar
        float sl = dx != 0 ? (cv - prevLoVal) / float(dx) : 0.0
        int   eb = bar_index + ext_bars
        line l = line.new(prevLoBar, prevLoVal, eb, cv + sl * float(eb - cb),
                         color=col_lo, width=2, style=line.style_solid)
        array.push(loLines, l)
        if array.size(loLines) > num_str
            line.delete(array.shift(loLines))
    prevLoVal := cv
    prevLoBar := cb

// 山・谷マーク (小)
plotshape(not na(ph), "山", shape.circle, location.abovebar, color=col_ph, size=size.tiny)
plotshape(not na(pl), "谷", shape.circle, location.belowbar, color=col_pl, size=size.small)

// ──────────────────────────────────────────────────────────────────
// 最新ひも投影値 (現在バーにおける天/底のひもの価格)
// ──────────────────────────────────────────────────────────────────

float projHi    = na
float projLo    = na
bool  nearHiAny = false
bool  nearLoAny = false

if array.size(hiLines) > 0
    projHi := lineY(array.get(hiLines, array.size(hiLines) - 1), bar_index)
    for _i = 0 to array.size(hiLines) - 1
        float _yh = lineY(array.get(hiLines, _i), bar_index)
        if math.abs(high - _yh) <= (float(touch_pips) * pip)
            nearHiAny := true

if array.size(loLines) > 0
    projLo := lineY(array.get(loLines, array.size(loLines) - 1), bar_index)
    for _i = 0 to array.size(loLines) - 1
        float _yl = lineY(array.get(loLines, _i), bar_index)
        if math.abs(low - _yl) <= (float(touch_pips) * pip)
            nearLoAny := true

// ──────────────────────────────────────────────────────────────────
// 純度計算 (Directional Efficiency)
//
//   LONG 用純度: 直近スイングハイ以降、どれだけ純粋に下落してきたか
//   SHORT用純度: 直近スイングロー以降、どれだけ純粋に上昇してきたか
//
//   純度 = |目標方向への純移動量| ÷ 累積絶対移動量 × 100%
// ──────────────────────────────────────────────────────────────────

// スイングハイ確定 → LONG用純度カウント開始 (下落の純度を測る)
// スイングロー確定 → SHORT用純度カウント開始 (上昇の純度を測る)

var float cumAbsLong  = 0.0   // LONG用: 直近SwingHigh以降の累積絶対移動
var float netDownLong = 0.0   // LONG用: 直近SwingHigh以降の下方向純移動
var float cumAbsShort = 0.0   // SHORT用: 直近SwingLow以降の累積絶対移動
var float netUpShort  = 0.0   // SHORT用: 直近SwingLow以降の上方向純移動

// スイングハイで LONG用純度をリセット
// pivotは swing_len バー遅延して検出される。その間の動きを遡って取込む。
if not na(ph)
    float _rAbs = 0.0
    float _rNet = 0.0
    if swing_len > 1
        for _i = 1 to swing_len - 1
            float _d = close[_i] - close[_i + 1]
            _rAbs += math.abs(_d)
            _rNet += (-_d)           // close[i+1]→close[i] の下落分がプラス
    cumAbsLong  := _rAbs
    netDownLong := _rNet

// スイングローで SHORT用純度をリセット
if not na(pl)
    float _rAbs = 0.0
    float _rNet = 0.0
    if swing_len > 1
        for _i = 1 to swing_len - 1
            float _d = close[_i] - close[_i + 1]
            _rAbs += math.abs(_d)
            _rNet += _d              // close[i+1]→close[i] の上昇分がプラス
    cumAbsShort := _rAbs
    netUpShort  := _rNet

// 各バーの移動量を累積
float barMove = math.abs(close - close[1])

cumAbsLong  += barMove
netDownLong += (close[1] - close)   // 下落がプラス
cumAbsShort += barMove
netUpShort  += (close - close[1])   // 上昇がプラス

// 純度 (0〜100%)
float purLong  = cumAbsLong  > 0.0 ? math.max(netDownLong / cumAbsLong  * 100.0, 0.0) : 0.0
float purShort = cumAbsShort > 0.0 ? math.max(netUpShort  / cumAbsShort * 100.0, 0.0) : 0.0

// ──────────────────────────────────────────────────────────────────
// シグナル判定
//
//   LONG : 底のひも投影値に到達 + 下落の純度が高い + クールダウン
//   SHORT: 天のひも投影値に到達 + 上昇の純度が高い + クールダウン
//   TRL  : ひも横断 (シグナル未満の接触マーク)
// ──────────────────────────────────────────────────────────────────

var int lastSig    = -999
var int lastSigDir = 0    // 1=直近LONG, -1=直近SHORT（交互制限）

// ──────────────────────────────────────────────────────────────────
// BB%B 極値 + 反転確認
//  ・まだ同方向に動き続けている場合（BB%bが継続上昇/下落）はスキップ
//  ・BB%bが極値から折り返し始めた最初のバーで発火
// ──────────────────────────────────────────────────────────────────
bool atBBLow  = bb_pct <= 0.12 and bb_pct >= bb_pct[1]   // 下限域 かつ BB%b上昇中(反発確認)
bool atBBHigh = bb_pct >= 0.88 and bb_pct <= bb_pct[1]   // 上限域 かつ BB%b下落中(反落確認)

// ──────────────────────────────────────────────────────────────────
// 交互方向制限: LONGの次はSHORTのみ、SHORTの次はLONGのみ
//  → 同方向の連続シグナル（SHORT×5 など）を根本的に防止
// ──────────────────────────────────────────────────────────────────
bool canLong  = lastSigDir != 1
bool canShort = lastSigDir != -1

bool longOk  = (canLong  and (nearLoAny or atBBLow)  and purLong  >= sig_purity and adxOk and (bar_index - lastSig) > cooldown)
bool shortOk = (canShort and (nearHiAny or atBBHigh) and purShort >= sig_purity and adxOk and (bar_index - lastSig) > cooldown)

if longOk
    lastSig    := bar_index
    lastSigDir := 1
if shortOk
    lastSig    := bar_index
    lastSigDir := -1

// TRL: ひもクロス (LONG/SHORTでない場合) — クールダウン付きで密集防止
bool trlLo = (not na(projLo) and ta.cross(close, projLo) and not longOk)
bool trlHi = (not na(projHi) and ta.cross(close, projHi) and not shortOk)
var int lastTrl = -999
bool trlOk = (trlLo or trlHi) and (bar_index - lastTrl) > trl_cd
if trlOk
    lastTrl := bar_index

// ──────────────────────────────────────────────────────────────────
// シグナル表示
// ──────────────────────────────────────────────────────────────────

plotshape(longOk,  "LONG ▲",  shape.labelup,   location.belowbar,
          color=col_long, textcolor=color.black, text="LONG",  size=size.normal)
plotshape(shortOk, "SHORT ▼", shape.labeldown, location.abovebar,
          color=col_sht,  textcolor=color.white, text="SHORT", size=size.normal)
plotshape(trlOk,   "TRL",     shape.triangleup, location.belowbar,
          color=col_trl, textcolor=color.aqua,  text="TRL",   size=size.tiny)

// ──────────────────────────────────────────────────────────────────
// 未来予測ラベル: 最新ひもの延長先に価格を表示
// ──────────────────────────────────────────────────────────────────

var label predHi = na
var label predLo = na

if barstate.islast
    if not na(predHi)
        label.delete(predHi)
    if not na(predLo)
        label.delete(predLo)
    if array.size(hiLines) > 0
        int   fb  = bar_index + ext_bars
        float fy  = lineY(array.get(hiLines, array.size(hiLines) - 1), fb)
        predHi := label.new(fb, fy, "天 (予測)\n" + str.tostring(fy, "#.###"),
                           color=color.new(col_sht, 15), textcolor=color.white,
                           style=label.style_label_left, size=size.small)
    if array.size(loLines) > 0
        int   fb  = bar_index + ext_bars
        float fy  = lineY(array.get(loLines, array.size(loLines) - 1), fb)
        predLo := label.new(fb, fy, "底 (予測)\n" + str.tostring(fy, "#.###"),
                           color=color.new(col_long, 15), textcolor=color.black,
                           style=label.style_label_left, size=size.small)

// ──────────────────────────────────────────────────────────────────
// 情報テーブル (右上)
// ──────────────────────────────────────────────────────────────────

var table tbl = table.new(position.top_right, 2, 8,
                          bgcolor=color.new(color.black, 65),
                          border_color=color.new(color.gray, 50), border_width=1,
                          frame_color=color.new(color.aqua, 50), frame_width=1)

if barstate.islast
    table.cell(tbl, 0, 0, "天底ひも理論",  text_color=color.aqua, text_size=size.small,
               bgcolor=color.new(color.navy, 40), text_halign=text.align_center)
    table.cell(tbl, 1, 0, "String Theory", text_color=color.aqua, text_size=size.small,
               bgcolor=color.new(color.navy, 40), text_halign=text.align_center)

    color pbCol = (bb_pct <= 0.0 ? color.lime : bb_pct <= 0.15 ? color.green : bb_pct >= 1.0 ? color.red : bb_pct >= 0.85 ? color.orange : color.gray)
    table.cell(tbl, 0, 1, "BB %B",                       text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 1, str.tostring(bb_pct, "#.###"), text_color=pbCol,       text_size=size.tiny)

    color plCol = (purLong >= sig_purity ? col_long : purLong >= sig_purity * 0.6 ? color.orange : color.gray)
    table.cell(tbl, 0, 2, "LONG 純度 (下落の純粋さ)",        text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 2, str.tostring(math.round(purLong, 1)) + "%", text_color=plCol, text_size=size.tiny)

    color psCol = (purShort >= sig_purity ? col_sht : purShort >= sig_purity * 0.6 ? color.orange : color.gray)
    table.cell(tbl, 0, 3, "SHORT 純度 (上昇の純粋さ)",       text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 3, str.tostring(math.round(purShort, 1)) + "%", text_color=psCol, text_size=size.tiny)

    string hiStr = not na(projHi) ? str.tostring(projHi, "#.###") : "–"
    table.cell(tbl, 0, 4, "天のひも (SHORT圧)",  text_color=col_sht, text_size=size.tiny)
    table.cell(tbl, 1, 4, hiStr,                  text_color=col_sht, text_size=size.tiny)

    string loStr = not na(projLo) ? str.tostring(projLo, "#.###") : "–"
    table.cell(tbl, 0, 5, "底のひも (LONG圧)",   text_color=col_long, text_size=size.tiny)
    table.cell(tbl, 1, 5, loStr,                  text_color=col_long, text_size=size.tiny)

    string ppStr = not na(pp) ? str.tostring(pp, "#.###") : "–"
    table.cell(tbl, 0, 6, "Pivot PP (均衡)",  text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 6, ppStr,              text_color=col_piv,     text_size=size.tiny)

    color adxCol = (adxVal >= adx_thr ? color.red : adxVal >= adx_thr * 0.8 ? color.orange : color.green)
    string adxStr = str.tostring(math.round(adxVal, 1)) + (adxVal >= adx_thr ? " [トレンド NG]" : " [レンジ OK]")
    table.cell(tbl, 0, 7, "ADX (トレンド)",   text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 7, adxStr,             text_color=adxCol,      text_size=size.tiny)
