//@version=6
indicator("天底ひも理論 (String Theory)", shorttitle="StringTheory", overlay=true,
          max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════
//  天底ひも理論 (Tenbottom String Theory)  v2.0
//  わっきゃい氏考案
//
//  【天底ひも理論の核心】
//   「天のひも」= 山（スイングハイ）同士を結ぶライン → 上値抵抗
//   「底のひも」= 谷（スイングロー）同士を結ぶライン → 下値支持
//   ひもを右に延長し、価格がひもに触れたとき逆張りのチャンス
//
//  【シグナルの意味】
//   SHORT (▼赤) : 価格が「天のひも」に到達 → 売りエントリー候補
//   LONG  (▲緑) : 価格が「底のひも」に到達 → 買いエントリー候補
//   TRL        : Trend Line reach = ひもタッチポイント（小さな注意マーク）
//
//  【視覚要素】
//   水色実線  : 天のひも (山→山)・底のひも (谷→谷) 右延長
//   水色破線  : 天のひもと底のひもの交差ライン (クロスストリング)
//   青丸      : スイングロー（谷）マーク
//   赤丸      : スイングハイ（山）マーク
//   黄色水平線: 重要な水平サポート/レジスタンスレベル
//   緑背景    : LONGゾーン（底のひも接触圏）
//   赤背景    : SHORTゾーン（天のひも接触圏）
// ═══════════════════════════════════════════════════════════════════

// ──────────────────────────────────────────────────────────────────
// 入力設定
// ──────────────────────────────────────────────────────────────────

grp_swing = "スイング検出設定"
swing_len   = input.int(5,  "スイング検出期間 (左右バー数)", minval=1, maxval=30, group=grp_swing,
              tooltip="スイングハイ/ローを検出する際の左右バー数。大きいほど大きな転換点のみ検出。")
num_strings = input.int(5,  "表示ひも本数（上下それぞれ）",  minval=2, maxval=15, group=grp_swing)
extend_bars = input.int(50, "ひも右延長バー数",              minval=10, maxval=300, group=grp_swing)

grp_bb = "ボリンジャーバンド"
bb_len  = input.int   (20,    "BB 期間",  minval=1, group=grp_bb)
bb_mult = input.float (2.0,   "BB 乗数",  step=0.1, group=grp_bb)
bb_src  = input.source(close, "ソース",             group=grp_bb)
bb_show = input.bool  (true,  "BB 表示",            group=grp_bb)

grp_sig = "シグナル設定"
touch_pips   = input.int  (8,    "ひもタッチ判定 許容pips",       minval=1, maxval=50, group=grp_sig,
               tooltip="価格がひもの延長線から何pips以内に入ったときにシグナルを出すか。")
bb_long_thr  = input.float(0.20, "LONG発火 BB%B 閾値（以下）",    minval=0.0, maxval=0.5, step=0.05, group=grp_sig)
bb_short_thr = input.float(0.80, "SHORT発火 BB%B 閾値（以上）",   minval=0.5, maxval=1.0, step=0.05, group=grp_sig)
show_bg      = input.bool (true, "シグナルゾーン背景色を表示",                                group=grp_sig)
show_trl     = input.bool (true, "TRL タッチマーク表示",                                      group=grp_sig)

grp_level = "重要水平レベル (黄色ライン)"
show_key    = input.bool  (true,  "重要レベル表示",        group=grp_level)
key_mode    = input.string("自動", "検出モード",
              options=["自動", "手動"],                     group=grp_level,
              tooltip="「自動」: 直近の最も高いスイングローを重要レベルとして追跡。「手動」: 下の価格を使用。")
key_manual  = input.float (0.0,  "  └ 手動価格",           group=grp_level)
key_lb      = input.int   (300,  "  └ 自動検出ルックバック (バー数)", minval=50, maxval=2000, group=grp_level)

grp_col = "カラー設定"
col_top     = input.color(color.aqua,                 "天のひも色",     group=grp_col)
col_bot     = input.color(color.aqua,                 "底のひも色",     group=grp_col)
col_cross   = input.color(color.new(color.aqua, 60),  "クロスライン色", group=grp_col)
col_key     = input.color(color.yellow,               "重要レベル色",   group=grp_col)
col_long    = input.color(color.lime,                 "LONGシグナル色", group=grp_col)
col_short   = input.color(color.red,                  "SHORTシグナル色",group=grp_col)
col_pivH    = input.color(color.new(color.red, 30),   "山マーク色",     group=grp_col)
col_pivL    = input.color(color.blue,                 "谷マーク色",     group=grp_col)

// ──────────────────────────────────────────────────────────────────
// ボリンジャーバンド計算
// ──────────────────────────────────────────────────────────────────

float bb_basis = ta.sma(bb_src, bb_len)
float bb_dev   = ta.stdev(bb_src, bb_len)
float bb_upper = bb_basis + bb_mult * bb_dev
float bb_lower = bb_basis - bb_mult * bb_dev
float bb_bw    = bb_upper - bb_lower
float bb_pct   = bb_bw > 0.0 ? (close - bb_lower) / bb_bw : 0.5

p_mid = plot(bb_show ? bb_basis : na, "BB 中心", color=color.new(color.white, 55), linewidth=1)
p_top = plot(bb_show ? bb_upper : na, "BB 上限", color=color.new(color.gray,  45), linewidth=1)
p_bot = plot(bb_show ? bb_lower : na, "BB 下限", color=color.new(color.gray,  45), linewidth=1)
fill(p_top, p_bot, color=color.new(color.gray, 90), title="BB 帯域")

// ──────────────────────────────────────────────────────────────────
// スイングハイ・スイングロー検出
// ──────────────────────────────────────────────────────────────────

float ph = ta.pivothigh(high, swing_len, swing_len)
float pl = ta.pivotlow (low,  swing_len, swing_len)

// ──────────────────────────────────────────────────────────────────
// ひも描画用の状態管理
// ──────────────────────────────────────────────────────────────────

var float prevHiVal = na
var int   prevHiBar = na
var float prevLoVal = na
var int   prevLoBar = na

var line[] hiLines    = array.new_line()  // 天のひも
var line[] loLines    = array.new_line()  // 底のひも
var line[] crossLines = array.new_line()  // クロスライン（天→底）

// pips計算用
float pip = syminfo.mintick * 10.0

// ──────────────────────────────────────────────────────────────────
// ひも描画ヘルパー関数
// ──────────────────────────────────────────────────────────────────

// ラインのY値を指定barで計算
lineYatBar(line l, int targetBar) =>
    int   x1  = line.get_x1(l)
    float y1  = line.get_y1(l)
    int   x2  = line.get_x2(l)
    float y2  = line.get_y2(l)
    int   dx  = x2 - x1
    float sl  = dx != 0 ? (y2 - y1) / float(dx) : 0.0
    y1 + sl * float(targetBar - x1)

// ──────────────────────────────────────────────────────────────────
// 天のひも: スイングハイ → スイングハイ (右延長)
// ──────────────────────────────────────────────────────────────────

if not na(ph)
    int   cBar = bar_index - swing_len
    float cVal = ph

    if not na(prevHiVal)
        int   dx     = cBar - prevHiBar
        float slope  = dx != 0 ? (cVal - prevHiVal) / float(dx) : 0.0
        int   extBar = bar_index + extend_bars
        float extVal = cVal + slope * float(extBar - cBar)

        line l = line.new(prevHiBar, prevHiVal, extBar, extVal,
                         color=col_top, width=2, style=line.style_solid)
        array.push(hiLines, l)
        if array.size(hiLines) > num_strings
            line.delete(array.shift(hiLines))

    prevHiVal := cVal
    prevHiBar := cBar

// ──────────────────────────────────────────────────────────────────
// 底のひも: スイングロー → スイングロー (右延長)
// ──────────────────────────────────────────────────────────────────

if not na(pl)
    int   cBar = bar_index - swing_len
    float cVal = pl

    if not na(prevLoVal)
        int   dx     = cBar - prevLoBar
        float slope  = dx != 0 ? (cVal - prevLoVal) / float(dx) : 0.0
        int   extBar = bar_index + extend_bars
        float extVal = cVal + slope * float(extBar - cBar)

        line l = line.new(prevLoBar, prevLoVal, extBar, extVal,
                         color=col_bot, width=2, style=line.style_solid)
        array.push(loLines, l)
        if array.size(loLines) > num_strings
            line.delete(array.shift(loLines))

        // ── クロスライン: 直近の天のひも上の始点から現在の底まで斜め線 ─────
        // 「天のひも×底のひも」が交差するネット構造を作る
        if not na(prevHiVal) and not na(prevHiBar) and array.size(hiLines) > 0
            line lastHi  = array.get(hiLines, array.size(hiLines) - 1)
            float hiAtCur = lineYatBar(lastHi, cBar)
            int   extBar2 = bar_index + extend_bars

            // 天のひもの現在位置 → 底のひも現在位置へ向かうクロスライン
            float crSlope  = dx != 0 ? (cVal - hiAtCur) / float(dx) : 0.0
            float crExtVal = cVal + crSlope * float(extBar2 - cBar)

            line lc = line.new(prevHiBar, prevHiVal, extBar2, crExtVal,
                              color=col_cross, width=1, style=line.style_dashed)
            array.push(crossLines, lc)
            if array.size(crossLines) > num_strings
                line.delete(array.shift(crossLines))

    prevLoVal := cVal
    prevLoBar := cBar

// ──────────────────────────────────────────────────────────────────
// 山・谷マーク
// ──────────────────────────────────────────────────────────────────

plotshape(not na(ph), "山マーク (天)", shape.circle, location.abovebar, color=col_pivH, size=size.tiny)
plotshape(not na(pl), "谷マーク (底)", shape.circle, location.belowbar, color=col_pivL, size=size.small)

// ──────────────────────────────────────────────────────────────────
// ひも到達判定: 現在価格と各ひもの投影値の距離を計算
// ──────────────────────────────────────────────────────────────────

float tol = float(touch_pips) * pip

// 最新の天のひも投影値
float projHi = na
if array.size(hiLines) > 0
    line lh   = array.get(hiLines, array.size(hiLines) - 1)
    projHi   := lineYatBar(lh, bar_index)

// 最新の底のひも投影値
float projLo = na
if array.size(loLines) > 0
    line ll   = array.get(loLines, array.size(loLines) - 1)
    projLo   := lineYatBar(ll, bar_index)

bool nearHi = not na(projHi) and math.abs(close - projHi) <= tol
bool nearLo = not na(projLo) and math.abs(close - projLo) <= tol

// ──────────────────────────────────────────────────────────────────
// SHORT シグナル: 天のひも到達 + BB上限付近
// ──────────────────────────────────────────────────────────────────

bool short_cond = (nearHi and bb_pct >= bb_short_thr)

plotshape(short_cond, "SHORT ▼", shape.labeldown, location.abovebar,
          color=col_short, textcolor=color.white, text="SHORT", size=size.normal)

// SHORTゾーン背景（天のひも付近）
bgcolor(show_bg and nearHi ? color.new(col_short, 88) : na, title="SHORTゾーン背景")

// ──────────────────────────────────────────────────────────────────
// LONG シグナル: 底のひも到達 + BB下限付近
//              または スイングロー + 極端な売られ過ぎ（ひもより下への突き抜け）
// ──────────────────────────────────────────────────────────────────

bool long_cond_str = (nearLo and bb_pct <= bb_long_thr)
bool long_cond_ext = (not na(pl) and bb_pct <= 0.05)   // ひも下の極値ブレイク
bool long_cond     = (long_cond_str or long_cond_ext)

plotshape(long_cond, "LONG ▲", shape.labelup, location.belowbar,
          color=col_long, textcolor=color.black, text="LONG", size=size.normal)

// LONGゾーン背景（底のひも付近）
bgcolor(show_bg and nearLo ? color.new(col_long, 88) : na, title="LONGゾーン背景")

// ──────────────────────────────────────────────────────────────────
// TRL ラベル: ひもへの接触（LONGやSHORTではない軽微なタッチ）
// ──────────────────────────────────────────────────────────────────

bool trl_cond = (show_trl and (nearHi or nearLo) and not long_cond and not short_cond)

plotshape(trl_cond, "TRL", shape.triangleup, location.belowbar,
          color=color.new(col_top, 20), textcolor=col_top, text="TRL", size=size.tiny)

// ──────────────────────────────────────────────────────────────────
// 重要水平レベル (黄色ライン)
// ──────────────────────────────────────────────────────────────────

var float keyLvl  = na
var line  keyLine = na

// 自動: 最高値のスイングローを重要レベルとして追跡（上昇反転の起点となりうる支持線）
if show_key
    if key_mode == "手動"
        float kv = key_manual > 0.0 ? key_manual : na
        if not na(kv)
            if not na(keyLine)
                line.delete(keyLine)
            keyLine := line.new(bar_index - key_lb, kv, bar_index + extend_bars, kv,
                               color=col_key, width=2, style=line.style_solid)
    else
        if not na(pl)
            // 直近スイングローの中で最も高いものを重要レベルとする
            // (下値切り上げパターンの直近支持線)
            if na(keyLvl) or pl > keyLvl
                keyLvl := pl
        if not na(keyLvl)
            if not na(keyLine)
                line.delete(keyLine)
            keyLine := line.new(bar_index - key_lb, keyLvl,
                               bar_index + extend_bars, keyLvl,
                               color=col_key, width=2, style=line.style_solid)

// ──────────────────────────────────────────────────────────────────
// 情報テーブル (右上)
// ──────────────────────────────────────────────────────────────────

var table tbl = table.new(position.top_right, 2, 6,
                          bgcolor=color.new(color.black, 65),
                          border_color=color.new(color.gray, 50), border_width=1,
                          frame_color=color.new(color.aqua, 50), frame_width=1)

if barstate.islast
    // ヘッダー
    table.cell(tbl, 0, 0, "天底ひも理論",  text_color=color.aqua,  text_size=size.small,
               bgcolor=color.new(color.navy, 40), text_halign=text.align_center)
    table.cell(tbl, 1, 0, "String Theory", text_color=color.aqua,  text_size=size.small,
               bgcolor=color.new(color.navy, 40), text_halign=text.align_center)

    // BB %B
    color pbCol = bb_pct >= 1.0  ? color.red    :
                  bb_pct >= 0.80 ? color.orange  :
                  bb_pct <= 0.0  ? color.lime    :
                  bb_pct <= 0.20 ? color.green   : color.gray
    table.cell(tbl, 0, 1, "BB %B",                       text_color=color.white,  text_size=size.tiny)
    table.cell(tbl, 1, 1, str.tostring(bb_pct, "#.###"), text_color=pbCol,        text_size=size.tiny)

    // 天のひも投影値
    string hiStr = not na(projHi) ? str.tostring(projHi, "#.###") : "–"
    table.cell(tbl, 0, 2, "天のひも (SHORT線)", text_color=col_short, text_size=size.tiny)
    table.cell(tbl, 1, 2, hiStr,                text_color=col_short, text_size=size.tiny)

    // 底のひも投影値
    string loStr = not na(projLo) ? str.tostring(projLo, "#.###") : "–"
    table.cell(tbl, 0, 3, "底のひも (LONG線)", text_color=col_long, text_size=size.tiny)
    table.cell(tbl, 1, 3, loStr,               text_color=col_long, text_size=size.tiny)

    // 重要レベル
    string klStr = not na(keyLvl) ? str.tostring(keyLvl, "#.###") :
                   (key_mode == "手動" and key_manual > 0.0) ? str.tostring(key_manual, "#.###") : "–"
    table.cell(tbl, 0, 4, "重要レベル", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 4, klStr,        text_color=col_key,     text_size=size.tiny)

    // シグナル
    string sigTxt = short_cond ? "▼ SHORT エントリー候補" :
                    long_cond  ? "▲ LONG  エントリー候補" :
                    trl_cond   ? "△ TRL タッチ"           : "–  待機中"
    color  sigCol = short_cond ? col_short :
                    long_cond  ? col_long  :
                    trl_cond   ? col_top   : color.gray
    table.cell(tbl, 0, 5, "シグナル", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 5, sigTxt,     text_color=sigCol,      text_size=size.tiny)
