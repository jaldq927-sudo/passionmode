//@version=6
indicator("WEMOF - Wakkyai's Entry Model Of FX", shorttitle="WEMOF", overlay=true, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════
//  WEMOF (Wakkyai's Entry Model Of FX) インジケーター  v2.2
//  わっきゃい氏考案・ボリンジャーバンド±3σを使った逆張りスキャルピング手法
//
//  【手法の核心】
//   ±3σタッチ = WEMOFシグナルではない！
//   「説明できない異常な動き」のときだけWEMOFシグナルとなる。
//
//  【v2.0-v2.2 追加フィルター（高確率化）】
//   ① ADX フィルター: ADX < 35 = レンジ〜弱トレンド → 逆張り有利
//   ② RSI 確認: 70超(ショート) / 30未満(ロング) = 極値確認（情報表示）
//   ③ BBバンド幅フィルター: 帯域幅が平常の2.5倍超 = ニュース性急騰 → スキップ
//   ④ ピンバー判定: 実体/ヒゲ比率 < 40% = 価格拒絶の形 → より強いシグナル
//   ⑤ 純度フィルター(v2.2): 急激な動き = 高純度 → 候補
//      じわじわ5本以上かけて3σ到達 = 低純度 → スキップ
//      コンテキスト比較: 20-100バー平均を超える大きな動きは高純度と判定
//
//  【自動スキップ条件（説明できる動き）】
//   ・ラウンドナンバー付近 / 直近高安値ブレイク / ピボット付近
//   ・ADXが高い（トレンド中） / BBバンド幅が異常に広い（ニュース）
//
//  【必ず手動確認が必要なもの（自動化不可）】
//   ・ニュース・要人発言（円安けん制発言、Trump発言等）
//   ・三角持ち合いブレイク等のチャートパターン
//
//  【推奨設定】USD/JPY 5分足
// ═══════════════════════════════════════════════════════════════════

// ──────────────────────────────────────────────────────────────────
// 入力設定
// ──────────────────────────────────────────────────────────────────

// ── ボリンジャーバンド ──
bb_len   = input.int   (20,    "BB 期間 (Length)",        minval=1,                    group="Bollinger Bands (ボリンジャーバンド)")
bb_src   = input.source(close, "BB ソース",                                             group="Bollinger Bands (ボリンジャーバンド)")
bb_show1 = input.bool  (false, "±1σ 表示",                                             group="Bollinger Bands (ボリンジャーバンド)")
bb_show2 = input.bool  (true,  "±2σ 表示",                                             group="Bollinger Bands (ボリンジャーバンド)")

// ── %B 異常検知 ──
pb_look = input.int  (3,    "%B変化 計測バー数 (Lookback)",
          minval=1, maxval=10,
          tooltip="何バー前の%Bと比較して変化量を計算するか。デフォルト3バー。",
          group="%B Anomaly Detection (%B 異常検知)")
pb_thr  = input.float(0.30, "%B変化 異常閾値 (Threshold)",
          minval=0.05, maxval=1.5, step=0.05,
          tooltip="この値以上の%B変化量を「異常な動き」と判定する。大きいほど厳格。デフォルト0.30。",
          group="%B Anomaly Detection (%B 異常検知)")

// ── 説明可能性フィルター ──
use_rnd  = input.bool(true, "ラウンドナンバー付近 でスキップ",
           tooltip="例: 150.00円 などのキリのいい価格帯付近はトレンドに説明がつくためスキップ。",
           group="Explainability Filters (説明可能性フィルター)")
rnd_pips = input.int (10,   "  └ バッファ (pips)",
           minval=0, maxval=50,
           group="Explainability Filters (説明可能性フィルター)")

use_hl   = input.bool(true, "直近高安値ブレイク でスキップ",
           tooltip="直近N本の最高値・最安値を更新した場合はトレンド継続と判断してスキップ。",
           group="Explainability Filters (説明可能性フィルター)")
hl_look  = input.int (20,   "  └ ルックバック期間 (bars)",
           minval=5, maxval=100,
           group="Explainability Filters (説明可能性フィルター)")

use_piv  = input.bool(true, "ピボットポイント付近 でスキップ",
           tooltip="日次ピボットポイント (PP/R1/R2/S1/S2) 付近はサポレジに説明がつくためスキップ。",
           group="Explainability Filters (説明可能性フィルター)")
piv_pips = input.int (15,   "  └ バッファ (pips)",
           minval=0, maxval=100,
           group="Explainability Filters (説明可能性フィルター)")

// ── ピボットポイント ──
show_piv = input.bool(true,  "ピボットポイント表示",  group="Pivot Points (ピボットポイント)")
show_pp  = input.bool(true,  "PP 表示",              group="Pivot Points (ピボットポイント)")
show_r   = input.bool(true,  "R1/R2 表示",           group="Pivot Points (ピボットポイント)")
show_s   = input.bool(true,  "S1/S2 表示",           group="Pivot Points (ピボットポイント)")

// ── 表示設定 ──
show_tbl  = input.bool(true, "情報テーブル表示",          group="Visual (表示設定)")
show_prep = input.bool(true, "準備シグナル表示 (△▽)",    group="Visual (表示設定)",
            tooltip="±3σにタッチしたが終値がまだ超えていない段階（準備）を黄色三角で表示。")
show_bc   = input.bool(true, "シグナルバーをカラー表示",  group="Visual (表示設定)")

// ── アラート設定 ──
alt_prep  = input.bool(false, "準備段階でもアラートを鳴らす",
            tooltip="ONにすると±3σタッチ時（準備段階）にも通知を送る。OFFにするとWEMOFシグナル確定時のみ。",
            group="Alert (アラート設定)")

// ── 高精度フィルター (v2.1) ──
// 【設計方針】1日4-5シグナルを維持しつつ期待値を最大化
//   ・ADX/RSI はテーブル＆アラートに表示（手動判断の補助）
//   ・ADXは「強いトレンド(>35)のみ」ブロック（デフォルト閾値を緩和）
//   ・RSIはデフォルトOFF（情報表示のみ）
//   ・BBWは大幅ニュース急騰(2.5倍超)のみブロック

// ADX フィルター
use_adx   = input.bool (true, "ADX フィルター (強トレンド除外)",
            tooltip="ADX が閾値を超えるとき = 強トレンド中 = スキップ。35以上のみブロック推奨（4-5回/日確保）。",
            group="High-Accuracy Filters v2.1 (高精度フィルター)")
adx_len   = input.int  (14,   "  └ ADX 期間",   minval=5, maxval=50,
            group="High-Accuracy Filters v2.1 (高精度フィルター)")
adx_thr   = input.int  (35,   "  └ ADX 閾値 (この値未満でシグナル有効)",
            minval=15, maxval=60,
            tooltip="35未満=レンジ〜弱トレンドで有効。25に下げると精度↑シグナル↓。",
            group="High-Accuracy Filters v2.1 (高精度フィルター)")

// RSI 確認フィルター（デフォルト: 情報表示のみ）
use_rsi   = input.bool (false, "RSI ハードフィルター (デフォルト:OFF=情報表示のみ)",
            tooltip="ONにするとRSI極値のみシグナル発火。シグナル数が大きく減る。通常はOFFで手動確認推奨。",
            group="High-Accuracy Filters v2.1 (高精度フィルター)")
rsi_len   = input.int  (14,   "  └ RSI 期間", minval=5, maxval=50,
            group="High-Accuracy Filters v2.1 (高精度フィルター)")
rsi_ob    = input.int  (70,   "  └ 買われ過ぎ閾値 (ショート用)",
            minval=55, maxval=90,
            group="High-Accuracy Filters v2.1 (高精度フィルター)")
rsi_os    = input.int  (30,   "  └ 売られ過ぎ閾値 (ロング用)",
            minval=10, maxval=45,
            group="High-Accuracy Filters v2.1 (高精度フィルター)")

// BBバンド幅フィルター（大幅ニュース急騰のみ除外・閾値を緩和）
use_bbw   = input.bool  (true, "BBバンド幅フィルター (大幅ニュース急騰除外)",
            tooltip="バンド幅が平常の2.5倍超 = 明確なニュース性急騰 → スキップ。閾値を2.5に緩和（1日4-5回確保）。",
            group="High-Accuracy Filters v2.1 (高精度フィルター)")
bbw_look  = input.int   (50,  "  └ バンド幅 平均期間", minval=20, maxval=200,
            group="High-Accuracy Filters v2.1 (高精度フィルター)")
bbw_mult  = input.float (2.5, "  └ バンド幅 上限倍率",
            minval=1.5, maxval=5.0, step=0.1,
            tooltip="2.5倍超で除外（デフォルト）。厳格化は1.8、緩和は3.0。",
            group="High-Accuracy Filters v2.1 (高精度フィルター)")

// ピンバーフィルター（価格拒絶パターン確認・デフォルトOFF）
use_pin   = input.bool  (false, "ピンバー確認 (デフォルト:OFF)",
            tooltip="ONにすると実体が小さいローソク足のみシグナル。シグナルが大幅減少するが精度は最大化。",
            group="High-Accuracy Filters v2.1 (高精度フィルター)")
pin_ratio = input.float (0.40, "  └ 実体/値幅 上限比率",
            minval=0.1, maxval=0.7, step=0.05,
            tooltip="実体÷値幅 < この値 = ピンバー。0.40推奨。",
            group="High-Accuracy Filters v2.1 (高精度フィルター)")

// ── 純度フィルター (Movement Purity / 動きの純度) v2.2 ──
// 【わっきゃい氏の新知見】
//   「じわじわ5本以上かけて3σに近づく = 低純度 = WEMOF対象外」
//   「急激な1-2バーでの動き = 高純度 = WEMOF候補」
//   「20SMA〜100SMAの文脈で平均より大きな動きもWEMOF候補」
use_purity    = input.bool  (true, "純度フィルター (じわじわ3σ到達を除外)",
               tooltip="ONにすると、過去N本のうち多くのバーで既に%Bが極値付近にいた場合（じわじわ上昇）はスキップ。急激な動きのみWEMOFシグナルになります。",
               group="Movement Purity Filter (純度フィルター v2.2)")
purity_bars   = input.int   (5, "  └ 純度チェック期間 (バー数)", minval=2, maxval=10,
               tooltip="過去何バーをじわじわチェックするか。デフォルト5（5本以上かけたアプローチを除外）。",
               group="Movement Purity Filter (純度フィルター v2.2)")
purity_max    = input.int   (3, "  └ じわじわ判定: 許容極値バー数上限",
               minval=1, maxval=9,
               tooltip="過去purity_bars本のうちこの値以上が%B極値付近（>0.70 or <0.30）にいれば低純度と判定。デフォルト3（5本中3本以上 = じわじわ）。",
               group="Movement Purity Filter (純度フィルター v2.2)")
use_purity_ctx = input.bool (true, "  └ コンテキスト比較で低純度を上書き",
               tooltip="ONにすると、現在の%B変化が過去100バー平均の1.5倍以上なら、じわじわ判定でも純度OKと判定します（わっきゃい氏の20SMA-100SMAレンジ文脈の概念）。",
               group="Movement Purity Filter (純度フィルター v2.2)")
purity_ctx_m  = input.float (1.5, "    └ コンテキスト倍率 (平均の何倍以上で純度OK)",
               minval=1.0, maxval=5.0, step=0.1,
               tooltip="%B変化量が過去100バー平均の何倍以上なら純度OKとするか。デフォルト1.5倍。",
               group="Movement Purity Filter (純度フィルター v2.2)")

// ──────────────────────────────────────────────────────────────────
// ボリンジャーバンド計算
// ──────────────────────────────────────────────────────────────────
float bb_basis = ta.sma(bb_src, bb_len)
float bb_dev   = ta.stdev(bb_src, bb_len)

float u3 = bb_basis + 3.0 * bb_dev
float u2 = bb_basis + 2.0 * bb_dev
float u1 = bb_basis + 1.0 * bb_dev
float l1 = bb_basis - 1.0 * bb_dev
float l2 = bb_basis - 2.0 * bb_dev
float l3 = bb_basis - 3.0 * bb_dev

// ──────────────────────────────────────────────────────────────────
// %B 計算（±3σ基準）
//   %B = 0.0 → 下限 3σ
//   %B = 0.5 → 中心線
//   %B = 1.0 → 上限 3σ
//   %B > 1.0 or < 0.0 → ±3σを超えた領域
//
// 【わっきゃい氏の考え方】
//   「%Bの変化幅を見て、気持ち悪い相場では変化幅が大きくなるので、
//    相場の異常を示すシグナルとして見ています」
// ──────────────────────────────────────────────────────────────────
float bw   = u3 - l3
float pb   = bw > 0.0 ? (bb_src - l3) / bw : 0.5
float dPb  = math.abs(pb - pb[pb_look])    // %B の変化量（絶対値）
bool  anom = dPb >= pb_thr                  // 異常判定フラグ

// ──────────────────────────────────────────────────────────────────
// 日次ピボットポイント（前日の高値・安値・終値を使用）
//
// lookahead_off（デフォルト）を使用:
//   日足バーは「最後に確定した日足」のデータを返すため、
//   当日の5分足バー群はすべて「前日の確定値」を参照できる。
//   → lookahead_on 不要。リペイント警告も出ない。
// ──────────────────────────────────────────────────────────────────
[dH, dL, dC] = request.security(syminfo.tickerid, "D", [high, low, close])

float PP = (dH + dL + dC) / 3.0
float R1 = 2.0 * PP - dL
float R2 = PP + (dH - dL)
float S1 = 2.0 * PP - dH
float S2 = PP - (dH - dL)

// ──────────────────────────────────────────────────────────────────
// 高精度フィルター計算 (v2.0)
// ──────────────────────────────────────────────────────────────────

// ADX (Average Directional Index) - レンジ相場判定
// ta.dmi(diLength, adxSmoothing) → [diPlus, diMinus, adx]
[diPlus, diMinus, adxVal] = ta.dmi(adx_len, adx_len)
bool adx_ok = not use_adx or adxVal < adx_thr    // ADX が低い = レンジ = 逆張り有利

// RSI - 買われ過ぎ・売られ過ぎ確認
float rsiVal   = ta.rsi(close, rsi_len)
bool  rsi_ok_s = not use_rsi or rsiVal >= rsi_ob  // ショート: RSI が高い = 買われ過ぎ
bool  rsi_ok_l = not use_rsi or rsiVal <= rsi_os  // ロング : RSI が低い = 売られ過ぎ

// BBバンド幅フィルター - 異常な急騰（ニュース性）を除外
// BBW(%) = (upper3σ - lower3σ) / 中心線 × 100
float bbw      = bw / bb_basis * 100.0
float bbw_avg  = ta.sma(bbw, bbw_look)
bool  bbw_ok   = not use_bbw or bbw <= bbw_avg * bbw_mult  // 幅が正常範囲内

// ピンバーフィルター - 実体小さく＝価格拒絶の形
float candle_body  = math.abs(close - open)
float candle_range = high - low
// 実体÷値幅 < pin_ratio → ピンバー（ヒゲが長く実体が小さい）
bool  is_pin   = candle_range > 0.0 ? (candle_body / candle_range) < pin_ratio : false
bool  pin_ok   = not use_pin or is_pin

// ──────────────────────────────────────────────────────────────────
// 純度フィルター計算 (Movement Purity v2.2)
// 【わっきゃい氏の概念】
//   高純度 = 急激な短時間での動き (1-2バーで3σに到達) = WEMOF候補
//   低純度 = じわじわ5本以上かけて3σに到達 = WEMOF対象外
//   コンテキスト: 20SMA-100SMAレンジ文脈で平均より大きな動き = 高純度
//
// 実装:
//   1. グラデュアル判定: 過去purity_bars本で%Bが既に極値付近にいたバー数をカウント
//      ≥ purity_max本 → じわじわ低純度 → スキップ
//   2. コンテキスト上書き: 現在dPb ≥ 100バー平均dPb × purity_ctx_m
//      → 平均を大きく超える動き → じわじわでも純度OK（大きな動きはWEMOF候補）
// ──────────────────────────────────────────────────────────────────

// 過去purity_bars本のうち既に「3σ付近」にいたバーをカウント
int cnt_hi = 0  // ショート側: %B > 0.70 (上限3σに近い領域)
int cnt_lo = 0  // ロング側:   %B < 0.30 (下限3σに近い領域)
for i = 1 to purity_bars
    cnt_hi := cnt_hi + (pb[i] > 0.70 ? 1 : 0)
    cnt_lo := cnt_lo + (pb[i] < 0.30 ? 1 : 0)

// じわじわ判定フラグ (低純度)
bool is_gradual_s = cnt_hi >= purity_max   // ショート: 多くのバーで既に上限付近
bool is_gradual_l = cnt_lo >= purity_max   // ロング:   多くのバーで既に下限付近

// コンテキスト比較: 現在のdPbが過去100バー平均より大きな動きか
float avg_dPb_ctx = ta.sma(dPb, 100)
bool  ctx_large   = use_purity_ctx and (dPb >= avg_dPb_ctx * purity_ctx_m)

// 純度判定: (じわじわでない) または (コンテキストを超える大きな動き)
bool pure_ok_s = not use_purity or (not is_gradual_s) or ctx_large
bool pure_ok_l = not use_purity or (not is_gradual_l) or ctx_large

// ──────────────────────────────────────────────────────────────────
// 説明可能性フィルター
// 「この動きは説明できるか？」→ 説明できるならスキップ
// ──────────────────────────────────────────────────────────────────

// pip サイズを通貨ペアから自動判定（JPY系か否か）
bool  is_jpy  = str.contains(syminfo.basecurrency, "JPY") or str.contains(syminfo.currency, "JPY")
float pip_sz  = is_jpy ? 0.01 : 0.0001
float rnd_u   = is_jpy ? 1.0  : 0.01    // ラウンドナンバー単位（JPY: 150.00, Non-JPY: 1.1000）

// フィルター 1: ラウンドナンバー付近
float rnd_buf  = rnd_pips * pip_sz
bool  nr       = math.abs(close - math.round(close / rnd_u) * rnd_u) <= rnd_buf

// フィルター 2: 直近高安値ブレイク（=トレンド継続の説明がつく）
float prev_hi  = ta.highest(high, hl_look)[1]
float prev_lo  = ta.lowest (low,  hl_look)[1]
bool  brk_up   = high > prev_hi    // 直近高値更新 → 上昇トレンドで説明可
bool  brk_dn   = low  < prev_lo    // 直近安値更新 → 下落トレンドで説明可

// フィルター 3: ピボットポイント付近
float piv_buf  = piv_pips * pip_sz
bool  np       = (math.abs(close - PP) <= piv_buf) or
                 (math.abs(close - R1) <= piv_buf) or
                 (math.abs(close - R2) <= piv_buf) or
                 (math.abs(close - S1) <= piv_buf) or
                 (math.abs(close - S2) <= piv_buf)

// 総合判定: 説明できる動きか？
bool expl = (use_rnd and nr) or (use_hl and (brk_up or brk_dn)) or (use_piv and np)
bool unex = not expl    // 説明できない = WEMOFの候補

// ──────────────────────────────────────────────────────────────────
// WEMOFシグナル条件
//
// 【2段階構造】（わっきゃい氏: 「準備をし、さらに超えてきたときに逆張りする」）
//   段階1 [準備]: 高値/安値が±3σにタッチ、しかし終値はまだバンド内
//   段階2 [シグナル]: 終値が初めて±3σを突き抜けた
// ──────────────────────────────────────────────────────────────────

// ──────────────────────────────────────────────────────────────────
// フィルター統合判定（v2.1設計）
//
//  ハードフィルター（シグナルをブロック）:
//    ADX > 閾値(35) → 強トレンド中 → スキップ
//    BBW > 2.5倍    → 明確なニュース急騰 → スキップ
//    ピンバー(任意) → 拒絶形なし → スキップ
//
//  情報フィルター（テーブル・アラートに表示、手動判断に使用）:
//    RSI  → テーブルで確認、アラートメッセージに含む
// ──────────────────────────────────────────────────────────────────
// ハードフィルター統合（ADX + BBW + ピンバー）
// RSI は上部で定義済み（rsi_ok_s / rsi_ok_l）
bool hard_ok = adx_ok and bbw_ok and pin_ok

// 準備段階: 高値(安値)がバンドに届いたが終値は超えていない
bool prep_s = high >= u3 and close < u3 and anom and unex
bool prep_l = low  <= l3 and close > l3 and anom and unex

// WEMOFシグナル: 終値がバンドを初めて突き抜けた瞬間のみ
// v2.1: ADX強トレンド除外 + BBW大幅急騰除外 + ピンバー(任意) のみハードブロック
//       RSIはデフォルトOFF（use_rsiをONにすると追加ハードフィルター化）
bool sig_s = ta.crossover (close, u3) and anom and unex and hard_ok and rsi_ok_s and pure_ok_s
bool sig_l = ta.crossunder(close, l3) and anom and unex and hard_ok and rsi_ok_l and pure_ok_l

bool any_sig  = sig_s or sig_l
bool any_prep = prep_s or prep_l

// ──────────────────────────────────────────────────────────────────
// プロット: ボリンジャーバンド
// ──────────────────────────────────────────────────────────────────
plot(bb_basis,             "BB 中心線 (SMA20)", color=color.new(color.gray, 35), linewidth=1)
pu3 = plot(u3,             "上限 3σ",           color=color.new(color.red,   5), linewidth=2)
pu2 = plot(bb_show2?u2:na, "上限 2σ",           color=color.new(color.red,  55), linewidth=1)
pu1 = plot(bb_show1?u1:na, "上限 1σ",           color=color.new(color.orange,60), linewidth=1)
pl1 = plot(bb_show1?l1:na, "下限 1σ",           color=color.new(color.teal, 60), linewidth=1)
pl2 = plot(bb_show2?l2:na, "下限 2σ",           color=color.new(color.lime, 55), linewidth=1)
pl3 = plot(l3,             "下限 3σ",           color=color.new(color.lime,  5), linewidth=2)

fill(pu3, pu2, color=color.new(color.red,   92), title="上限 3σ-2σ フィルゾーン")
fill(pl2, pl3, color=color.new(color.green, 92), title="下限 3σ-2σ フィルゾーン")

// ──────────────────────────────────────────────────────────────────
// プロット: ピボットポイント
// ──────────────────────────────────────────────────────────────────
plot(show_piv and show_pp ? PP : na, "PP",  color=color.new(color.white, 35), linewidth=1, style=plot.style_linebr)
plot(show_piv and show_r  ? R1 : na, "R1",  color=color.new(color.red,   35), linewidth=1, style=plot.style_linebr)
plot(show_piv and show_r  ? R2 : na, "R2",  color=color.new(color.red,   55), linewidth=1, style=plot.style_linebr)
plot(show_piv and show_s  ? S1 : na, "S1",  color=color.new(color.lime,  35), linewidth=1, style=plot.style_linebr)
plot(show_piv and show_s  ? S2 : na, "S2",  color=color.new(color.lime,  55), linewidth=1, style=plot.style_linebr)

// ──────────────────────────────────────────────────────────────────
// プロット: シグナル表示
// ──────────────────────────────────────────────────────────────────

// 準備シグナル（黄色三角 - 小さめ）
plotshape(show_prep and prep_s, "準備: ショート候補",
    style=shape.triangledown, location=location.abovebar,
    color=color.new(color.yellow, 20), size=size.small,
    text="準備", textcolor=color.new(color.yellow, 0))

plotshape(show_prep and prep_l, "準備: ロング候補",
    style=shape.triangleup, location=location.belowbar,
    color=color.new(color.yellow, 20), size=size.small,
    text="準備", textcolor=color.new(color.yellow, 0))

// ── WEMOFエントリーシグナル ──
// SHORT（売り）: 赤のラベルを上から押しつけるスタイル
plotshape(sig_s, "SHORT (売り・ショート)",
    style=shape.labeldown, location=location.abovebar,
    color=color.new(color.red,  0), size=size.large,
    text="SHORT", textcolor=color.white)

// LONG（買い）: 緑のラベルを下から押し上げるスタイル
plotshape(sig_l, "LONG (買い・ロング)",
    style=shape.labelup, location=location.belowbar,
    color=color.new(color.lime, 0), size=size.large,
    text="LONG", textcolor=color.white)

// バーカラー（シグナル発生時のバーを着色）
barcolor(show_bc and sig_l   ? color.new(color.lime,   22) :
         show_bc and sig_s   ? color.new(color.red,    22) :
         show_bc and prep_l  ? color.new(color.yellow, 55) :
         show_bc and prep_s  ? color.new(color.yellow, 55) : na)

// ──────────────────────────────────────────────────────────────────
// 情報テーブル（右上）  ※ 各行の「エントリー条件」の目安は README 参照
// ──────────────────────────────────────────────────────────────────
var table T = table.new(position.top_right, 2, 14,
    bgcolor      = color.new(color.black, 70),
    border_width = 1,
    border_color = color.new(color.gray,  50),
    frame_width  = 2,
    frame_color  = color.new(color.blue,  20))

if show_tbl and barstate.islast

    // タイムフレームラベル
    tf_str = (timeframe.isintraday ? timeframe.period + "分足" :
              timeframe.isdaily    ? "日足" :
              timeframe.isweekly   ? "週足" : timeframe.period + "足")

    // ── 行0: ヘッダー ──
    table.cell(T, 0, 0, "WEMOF v2.2",
        text_color=color.white, text_size=size.small,
        bgcolor=color.new(color.navy, 15))
    table.cell(T, 1, 0, syminfo.ticker + "  " + tf_str,
        text_color=color.yellow, text_size=size.small,
        bgcolor=color.new(color.navy, 15))

    // ── 行1: %B 現在値 ── エントリー目安: ≥1.0(SHORT) / ≤0.0(LONG)
    pb_col = (pb >= 1.0 or pb <= 0.0 ? color.red :
              pb >= 0.85 or pb <= 0.15 ? color.orange : color.white)
    pb_entry = (pb >= 1.0 ? " SHORT域" : pb <= 0.0 ? " LONG域" : "")
    table.cell(T, 0, 1, "%B  [目安:>=1.0 or <=0.0]", text_color=color.gray, text_size=size.tiny)
    table.cell(T, 1, 1, str.tostring(pb, "#.###") + pb_entry, text_color=pb_col, text_size=size.small)

    // ── 行2: %B 変化量 ── エントリー目安: ≥ 0.30（デフォルト閾値）
    dpb_col = anom ? color.red : dPb >= pb_thr * 0.7 ? color.orange : color.white
    dpb_str = str.tostring(dPb, "#.###") + (anom ? " [>="+str.tostring(pb_thr,"#.##")+" 異常]" : " [正常]")
    table.cell(T, 0, 2, "%B変化量  [目安:>=" + str.tostring(pb_thr,"#.##") + "]", text_color=color.gray, text_size=size.tiny)
    table.cell(T, 1, 2, dpb_str, text_color=dpb_col, text_size=size.small)

    // ── 行3: 3σ 位置 ── エントリー目安: +3σ超え or -3σ超え
    s3_txt = (close >= u3 ? "+3σ超 [SHORT候補]" :
              high  >= u3 ? "+3σタッチ [準備]" :
              close <= l3 ? "-3σ超 [LONG候補]" :
              low   <= l3 ? "-3σタッチ [準備]" : "通常域")
    s3_col = ((close >= u3 or close <= l3) ? color.red :
              (high  >= u3 or low  <= l3)  ? color.yellow : color.new(color.white, 30))
    table.cell(T, 0, 3, "3σ状態  [目安:3σ超え]", text_color=color.gray, text_size=size.tiny)
    table.cell(T, 1, 3, s3_txt, text_color=s3_col, text_size=size.small)

    // ── 行4: ADX ── エントリー目安: < 25（レンジ相場）
    adx_col = (adxVal < adx_thr ? color.lime :
               adxVal < adx_thr + 5 ? color.yellow : color.red)
    adx_str = str.tostring(adxVal, "#.#") + (adxVal < adx_thr ? " [レンジ OK]" : " [トレンド NG]")
    table.cell(T, 0, 4, "ADX  [目安:<" + str.tostring(adx_thr) + " レンジ]", text_color=color.gray, text_size=size.tiny)
    table.cell(T, 1, 4, adx_str, text_color=adx_col, text_size=size.small)

    // ── 行5: RSI ── エントリー目安: ≥70(SHORT) / ≤30(LONG)
    rsi_col = (rsiVal >= rsi_ob ? color.red :
               rsiVal <= rsi_os ? color.lime :
               rsiVal >= rsi_ob - 10 or rsiVal <= rsi_os + 10 ? color.orange : color.white)
    rsi_str = str.tostring(rsiVal, "#.#") + (rsiVal >= rsi_ob ? " [過熱 SHORT]" : rsiVal <= rsi_os ? " [冷却 LONG]" : "")
    table.cell(T, 0, 5, "RSI  [目安:>=" + str.tostring(rsi_ob) + " or <=" + str.tostring(rsi_os) + "]", text_color=color.gray, text_size=size.tiny)
    table.cell(T, 1, 5, rsi_str, text_color=rsi_col, text_size=size.small)

    // ── 行6: BBバンド幅 ── エントリー目安: 平常の1.8倍未満
    bbw_ratio = bbw_avg > 0 ? bbw / bbw_avg : 1.0
    bbw_col   = bbw_ok ? color.lime : color.red
    bbw_str   = str.tostring(bbw_ratio, "#.##") + "倍" + (bbw_ok ? " [正常]" : " [異常広 NG]")
    table.cell(T, 0, 6, "BBW幅比  [目安:<" + str.tostring(bbw_mult, "#.#") + "倍]", text_color=color.gray, text_size=size.tiny)
    table.cell(T, 1, 6, bbw_str, text_color=bbw_col, text_size=size.small)

    // ── 行7: ピンバー ── エントリー目安: 実体比率 < 40%
    pin_str = str.tostring(candle_range > 0 ? candle_body/candle_range * 100 : 0.0, "#.#") + "%" + (is_pin ? " [ピンバー]" : "")
    pin_col = is_pin ? color.lime : color.new(color.white, 30)
    table.cell(T, 0, 7, "実体比率  [目安:<" + str.tostring(pin_ratio * 100, "#") + "%]", text_color=color.gray, text_size=size.tiny)
    table.cell(T, 1, 7, pin_str, text_color=pin_col, text_size=size.small)

    // ── 行8: 説明可能性 ── エントリー目安: 「説明不可」
    reason = (expl ?
        (use_rnd and nr     ? "ラウンドナンバー付近" :
         use_hl  and brk_up ? "直近高値ブレイク" :
         use_hl  and brk_dn ? "直近安値ブレイク" :
         use_piv and np     ? "ピボット付近" : "フィルター該当") :
        "説明不可 [候補]")
    expl_col = expl ? color.orange : color.lime
    table.cell(T, 0, 8, "説明可能性  [目安:説明不可]", text_color=color.gray, text_size=size.tiny)
    table.cell(T, 1, 8, reason, text_color=expl_col, text_size=size.small)

    // ── 行9: 純度 ── エントリー目安: 高純度（急激な動き）
    bool cur_is_gradual = pb > 0.5 ? is_gradual_s : is_gradual_l
    int  cur_cnt        = pb > 0.5 ? cnt_hi : cnt_lo
    bool cur_pure_ok    = pb > 0.5 ? pure_ok_s : pure_ok_l
    purity_disp = (not use_purity    ? "OFF (フィルター無効)" :
                   ctx_large         ? "高純度 [コンテキスト超]" :
                   cur_is_gradual    ? "低純度 [じわじわ NG] " + str.tostring(cur_cnt) + "/" + str.tostring(purity_bars) + "本" :
                   "高純度 [急激] " + str.tostring(cur_cnt) + "/" + str.tostring(purity_bars) + "本")
    purity_col = not use_purity ? color.gray : cur_pure_ok ? color.lime : color.red
    table.cell(T, 0, 9, "純度  [目安:高純度=急激な動き]", text_color=color.gray, text_size=size.tiny)
    table.cell(T, 1, 9, purity_disp, text_color=purity_col, text_size=size.small)

    // ── 行10: 総合シグナル ──
    sg_txt = (sig_l   ? "WEMOF LONG [BUY]" :
              sig_s   ? "WEMOF SHORT [SELL]" :
              prep_l  ? "ロング準備中..." :
              prep_s  ? "ショート準備中..." : "待機中...")
    sg_col = (sig_l  ? color.lime : sig_s ? color.red :
              (prep_l or prep_s) ? color.yellow : color.gray)
    table.cell(T, 0, 10, "シグナル", text_color=color.white, text_size=size.small)
    table.cell(T, 1, 10, sg_txt, text_color=sg_col, text_size=size.small)

    // ── 行11: ±3σ レベル ──
    table.cell(T, 0, 11, "+3σ / -3σ", text_color=color.gray, text_size=size.tiny)
    table.cell(T, 1, 11,
        str.tostring(u3, "#.###") + " / " + str.tostring(l3, "#.###"),
        text_color=color.white, text_size=size.tiny)

    // ── 行12: ピボット主要値 ──
    table.cell(T, 0, 12, "PP / R1 / S1", text_color=color.gray, text_size=size.tiny)
    table.cell(T, 1, 12,
        str.tostring(PP, "#.###") + " / " +
        str.tostring(R1, "#.###") + " / " +
        str.tostring(S1, "#.###"),
        text_color=color.white, text_size=size.tiny)

    // ── 行13: 警告 ──
    table.cell(T, 0, 13, "!! ニュース確認必須 !!",
        text_color=color.orange, bgcolor=color.new(color.orange, 82), text_size=size.tiny)
    table.cell(T, 1, 13, "手動フィルター要",
        text_color=color.orange, bgcolor=color.new(color.orange, 82), text_size=size.tiny)

// ──────────────────────────────────────────────────────────────────
// アラート
//
// 【無料プラン対応 - 1つのアラートで全通知に対応】
//
// 設定方法:
//   ① チャートにこのインジケーターを追加
//   ② 「アラームを追加」(時計アイコン) をクリック
//   ③ 条件: 「WEMOF - Wakkyai's Entry Model Of FX」→「Any alert() function call」
//   ④ 通知方法を選択してアラート作成
//   → ロング・ショート・準備 すべての通知を1つのアラートで受け取れます！
//
// alert()関数はPineスクリプト内で動的メッセージを送れるため、
// 1つのアラート設定でロング/ショートの区別も通知テキストに含められます。
// ──────────────────────────────────────────────────────────────────

// ── 準備段階アラート (alt_prepがONの場合のみ) ──
if alt_prep
    if prep_s
        alert(
            "[WEMOF準備-SHORT] " + syminfo.ticker +
            " | +3σ到達: " + str.tostring(u3, "#.###") +
            " | 終値がさらに上を超えたらショートエントリー検討" +
            " | !! ニュース・テクニカル確認を !!",
            alert.freq_once_per_bar_close)
    if prep_l
        alert(
            "[WEMOF準備-LONG] " + syminfo.ticker +
            " | -3σ到達: " + str.tostring(l3, "#.###") +
            " | 終値がさらに下を超えたらロングエントリー検討" +
            " | !! ニュース・テクニカル確認を !!",
            alert.freq_once_per_bar_close)

// ── WEMOFシグナルアラート（メイン）──
// アラートメッセージにADX・RSIを含めることで、
// TradingViewを開かずにスマートフォンで即座に判断できる
if sig_s
    alert(
        "[SHORT] " + syminfo.ticker +
        " | 終値: "    + str.tostring(close,  "#.###") +
        " | +3σ: "    + str.tostring(u3,     "#.###") +
        " | %B変化: " + str.tostring(dPb,    "#.##")  +
        " | ADX: "    + str.tostring(adxVal, "#.#") + (adxVal < 25 ? "(レンジ)" : adxVal < 35 ? "(弱T)" : "(強T!)") +
        " | RSI: "    + str.tostring(rsiVal, "#.#")   +
        " | 純度: 高純度(" + str.tostring(cnt_hi) + "/" + str.tostring(purity_bars) + "本)" +
        " | !! ニュース確認してからエントリー !!",
        alert.freq_once_per_bar_close)

if sig_l
    alert(
        "[LONG] " + syminfo.ticker +
        " | 終値: "    + str.tostring(close,  "#.###") +
        " | -3σ: "    + str.tostring(l3,     "#.###") +
        " | %B変化: " + str.tostring(dPb,    "#.##")  +
        " | ADX: "    + str.tostring(adxVal, "#.#") + (adxVal < 25 ? "(レンジ)" : adxVal < 35 ? "(弱T)" : "(強T!)") +
        " | RSI: "    + str.tostring(rsiVal, "#.#")   +
        " | 純度: 高純度(" + str.tostring(cnt_lo) + "/" + str.tostring(purity_bars) + "本)" +
        " | !! ニュース確認してからエントリー !!",
        alert.freq_once_per_bar_close)

// ── alertcondition（バックアップ: 手動アラート設定用） ──
// 上記のalert()とは別に、TradingViewのアラート作成画面でも選択できます。
// 無料プランでは上記のalert()方式（Any alert() function call）を推奨します。
alertcondition(
    any_sig or (alt_prep and any_prep),
    title   = "[WEMOF] Signal / シグナル発生",
    message = "WEMOFシグナル検出 | {{ticker}} | 現在値: {{close}} | チャートのシグナルでロング/ショートを確認してください")
